{
  "metadata": [
    {
      "src": [
        {
          "src": "../../..",
          "files": [
            "Momoka.Home/Momoka.Home.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "*.md",
          "articles/**/*.md",
          "toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**/*.png",
          "**/*.jpg"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Momoka.Home API Reference",
      "_appName": "Momoka.Home",
      "_appFooter": "© Momoka project",
      "_enableSearch": true
    },
    "template": [
      "default"
    ],
    "locale": [
      "en-US",
      "zh-CN"
    ]
  }
}