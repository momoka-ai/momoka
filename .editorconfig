root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ── .NET analyzer (CA) rule overrides ──────────────────────
[*.cs]
# WPF DependencyProperty-style ALL_CAPS property descriptors (TEXTURE, SOURCE_ID...)
dotnet_diagnostic.CA1707.severity = none
# Property system type is deliberately named "Property" (WPF convention)
dotnet_diagnostic.CA1716.severity = none
# Protected readonly backing fields are an intentional internal pattern
# (Entity._children, Graph._nodes, PalettedContainerRO internals)
dotnet_diagnostic.CA1051.severity = none
# VoxelLayout<T>.IsEntityCollided(dest, src, cs) is a pure predicate but part of
# the layout's instance collision API (kept non-static by design)
dotnet_diagnostic.CA1822.severity = none
# Subscribers marker interface (Bukkit Listener style) is deliberately unprefixed —
# concrete-first house style; the type name is the contract
dotnet_diagnostic.CA1715.severity = none

# EventHandler / EventHandler<T> are deliberate Bukkit-RegisteredListener analogues
# (per-event typed handler entries); the reserved-suffix naming is the contract
dotnet_diagnostic.CA1711.severity = none

# Event<T> deliberately uses per-constructed-type static members (static per-type handler table)
# and a public volatile array field — that is the whole point of the CRTP design
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA2211.severity = none

# xUnit assertions with inline arrays (Assert.Equal(new[] {...}, ...)) are idiomatic in tests
[Tests/**/*.cs]
dotnet_diagnostic.CA1861.severity = none
