<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Momoka.Core.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.28" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Momoka.Core/Momoka.Core.csproj" />
    <ProjectReference Include="Plugins/PluginAlpha/PluginAlpha.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins/PluginBeta/PluginBeta.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins/PluginBad/PluginBad.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins/PluginPlain/PluginPlain.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins/PluginExplode/PluginExplode.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins/PluginEvents/PluginEvents.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Plugins/PluginRouterBad/PluginRouterBad.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 嵌套插件工程由各自 csproj 独立编译；测试工程排除其源码与 obj 产物 -->
  <ItemGroup>
    <Compile Remove="Plugins/**" />
  </ItemGroup>

  <!--
    构建后把各测试插件产物拷入测试输出目录 plugins/<id>/，
    PluginLoaderTests 再把它们拷入独立临时目录进行加载测试。
  -->
  <Target Name="CopyTestPlugins" AfterTargets="Build">
    <ItemGroup>
      <_PluginAlphaFiles Include="Plugins/PluginAlpha/bin/$(Configuration)/net8.0/**/*" />
      <_PluginBetaFiles Include="Plugins/PluginBeta/bin/$(Configuration)/net8.0/**/*" />
      <_PluginBadFiles Include="Plugins/PluginBad/bin/$(Configuration)/net8.0/**/*" />
      <_PluginPlainFiles Include="Plugins/PluginPlain/bin/$(Configuration)/net8.0/**/*" />
      <_PluginExplodeFiles Include="Plugins/PluginExplode/bin/$(Configuration)/net8.0/**/*" />
      <_PluginEventsFiles Include="Plugins/PluginEvents/bin/$(Configuration)/net8.0/**/*" />
      <_PluginRouterBadFiles Include="Plugins/PluginRouterBad/bin/$(Configuration)/net8.0/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginAlphaFiles)"
          DestinationFolder="$(TargetDir)Plugins/alpha/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginBetaFiles)"
          DestinationFolder="$(TargetDir)Plugins/beta/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginBadFiles)"
          DestinationFolder="$(TargetDir)Plugins/bad/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginPlainFiles)"
          DestinationFolder="$(TargetDir)Plugins/plain/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginExplodeFiles)"
          DestinationFolder="$(TargetDir)Plugins/explode/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginEventsFiles)"
          DestinationFolder="$(TargetDir)Plugins/events/" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PluginRouterBadFiles)"
          DestinationFolder="$(TargetDir)Plugins/routerbad/" SkipUnchangedFiles="true" />
  </Target>

</Project>
